<!--
  Browser-SIP user directory, mounted into /etc/freeswitch/directory/default/.

  This mirrors the same <user> shape FreeSWITCH's own vanilla install uses
  for extensions 1000-1019 (which is why those already worked with
  MicroSIP) — it just defines a second, separate range (2000-2019) for
  browser users connecting via SIP.js over the internal profile's
  WebSocket listener (ws-binding :5066 / wss-binding :7443, already set in
  freeswitch/internal.xml).

  All 20 extensions share one demo password. The backend hands each
  logged-in user one of these extensions the first time they request
  their SIP config (see backend/src/sip/sip.service.ts) — keep the two
  files in sync if you ever change the range or the password.
-->
<include>
  <user id="2000">
    <params>
      <param name="password" value="ZibukeSip2026!"/>
      <param name="vm-password" value="2000"/>
    </params>
    <variables>
      <variable name="toll_allow" value="domestic,international,local"/>
      <variable name="accountcode" value="2000"/>
      <variable name="user_context" value="default"/>
      <variable name="effective_caller_id_name" value="Zibuke User 2000"/>
      <variable name="effective_caller_id_number" value="2000"/>
      <variable name="outbound_caller_id_name" value="$${outbound_caller_name}"/>
      <variable name="outbound_caller_id_number" value="$${outbound_caller_id_number}"/>
      <variable name="callgroup" value="zibuke_browser"/>
    </variables>
  </user>
